    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@nexplay/game-core": "*",
    "@nexplay/game-ludo": "*",
    "@prisma/client": "^6.5.0",
